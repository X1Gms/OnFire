<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="@dimen/space_6"
        android:gravity="center_horizontal"
        android:layout_marginTop="60dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_onfire_logo" />

        <!-- Título -->
        <TextView
            android:text="Recover Password"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="315dp" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:text="Insert your email so you may receive a link to recover your account"
            android:textColor="@color/text2"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="315dp" />

        <!-- Campo Email -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="315dp">

                <TextView
                    android:text="Email"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:layout_marginBottom="4dp"
                    android:paddingStart="10dp"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/tilEmail"
                    android:hint="Insert your Email"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/secondary"
                    app:hintTextColor="@color/text2"
                    app:boxStrokeColor="@color/secondary"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="3dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxBackgroundMode="outline"
                    android:layout_width="match_parent"
                    android:layout_height="58dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text2"
                        android:paddingStart="8dp"
                        android:paddingLeft="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Botão Send -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:text="Send"
            android:backgroundTint="@color/secondary"
            android:textColor="@color/text"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_6"
            app:cornerRadius="10dp"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:maxWidth="315dp" />

        <!-- Texto “I remember now!! Back to Login” -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="I remember now!! "
                android:textColor="@color/text"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvBackToLogin"
                android:text="Back to Login"
                android:textColor="@color/secondary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
