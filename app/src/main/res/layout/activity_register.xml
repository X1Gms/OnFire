<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="@dimen/space_6"
        android:gravity="center_horizontal"
        android:layout_marginTop="60dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_onfire_logo" />

        <!-- Título -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="315dp">

            <TextView
                android:text="Welcome to "
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="OnFire"
                android:textColor="@color/secondary"
                android:textStyle="italic|bold"
                android:textSize="26sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:text="Create your account and start your fitness journey"
            android:textColor="@color/text2"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_2"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="315dp" />

        <!-- Campo Email -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <LinearLayout
                android:orientation="vertical"
                android:maxWidth="315dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Email"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"
                    android:paddingStart="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/tilEmail"
                    android:hint="Insert your Email"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/secondary"
                    app:hintTextColor="@color/text2"
                    app:boxStrokeColor="@color/secondary"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="3dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxBackgroundMode="outline"
                    android:layout_width="match_parent"
                    android:layout_height="58dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text2"
                        android:paddingStart="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Campo Password -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <LinearLayout
                android:orientation="vertical"
                android:maxWidth="315dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Label + Ícone info -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:text="Password"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:paddingStart="10dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:id="@+id/ivInfoPassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:paddingEnd="10dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_info_circle"
                        android:contentDescription="Password Info"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/tilPassword"
                    android:hint="Insert your Password"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/secondary"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/secondary"
                    app:hintTextColor="@color/text2"
                    app:boxStrokeColor="@color/secondary"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="3dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxBackgroundMode="outline"
                    android:layout_width="match_parent"
                    android:layout_height="58dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:inputType="textPassword"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text2"
                        android:paddingStart="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Campo Confirm Password -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <LinearLayout
                android:orientation="vertical"
                android:maxWidth="315dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Confirm Password"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"
                    android:paddingStart="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:id="@+id/tilConfirm"
                    android:hint="Confirm your Password"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/secondary"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/secondary"
                    app:hintTextColor="@color/text2"
                    app:boxStrokeColor="@color/secondary"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="3dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxBackgroundMode="outline"
                    android:layout_width="match_parent"
                    android:layout_height="58dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirm"
                        android:inputType="textPassword"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text2"
                        android:paddingStart="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Botão Register -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:text="Register"
            android:backgroundTint="@color/secondary"
            android:textColor="@color/text"
            android:layout_marginTop="@dimen/space_6"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:maxWidth="315dp"
            app:cornerRadius="10dp"
            android:layout_gravity="center_horizontal" />

        <!-- Texto “You have an account? Login” -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="You have an account? "
                android:textColor="@color/text2"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLogin"
                android:text="Login"
                android:textColor="@color/secondary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
